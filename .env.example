# Public GitHub owner/repository containing the market-data branch. No token is needed to read it.
MARKET_DATA_REPOSITORY=fareza777/website-intel-x

# Public canonical origin used by metadata, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://cryptoscanora.top

# Optional Google Search Console HTML verification token. Add the value returned by Google here
# and to Vercel Production environment variables; leave empty until a property is created.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# CLI/local state only. Keep ignored; Vercel reads the public branch instead of durable local disk.
DATA_DIRECTORY=data

# Optional CLI/Actions watchlist, comma or whitespace separated. Empty uses the top liquid universe.
SCAN_SYMBOLS=
# Automatic universe: 20–50 (default 30). Explicit watchlist: 1–50 if a cap is intentionally set.
SCAN_LIMIT=

# Optional generic HTTPS JSON webhook. Set as a GitHub Actions secret for scheduled delivery.
# This value is a secret; it is never required by the browser or Vercel.
ALERT_WEBHOOK_URL=

# Optional manual-only paid commentary. Select an available model explicitly; no paid default.
# Set these in your terminal when running scripts/brief.ts. Never use NEXT_PUBLIC_ prefixes.
XAI_API_KEY=
XAI_MODEL=
